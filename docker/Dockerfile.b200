# Builds the validated YOCO runtime on top of the NVIDIA B200 environment.
# Build example:
#   docker build -f docker/Dockerfile.b200 \
#     -t buaahsh/pytorch:26.02-b200-vllm-0716 .

FROM donglixp/pytorch:26.02-b200@sha256:cdbdc71b773142a98a303d488816d2faf6b9d85d179a4639b92263fca6da4769

ENV PIP_NO_CACHE_DIR=1 \
    HF_HOME=/workspace/.cache/huggingface \
    VLLM_TARGET_DEVICE=cuda \
    TORCH_CUDA_ARCH_LIST=10.0 \
    MAX_JOBS=16 \
    NVCC_THREADS=1

WORKDIR /workspace

RUN git init /workspace/vllm \
    && cd /workspace/vllm \
    && git remote add origin https://github.com/buaahsh/vllm.git \
    && git fetch --depth 1 origin d4eb9942f9dc81c773d82b737b27dffda40cd56d \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "d4eb9942f9dc81c773d82b737b27dffda40cd56d"

WORKDIR /workspace/vllm

# Strip torch/torchvision/torchaudio requirements so the NVIDIA image torch is
# preserved. This is the required first step before pip install.
RUN python use_existing_torch.py

# Compatibility patch for donglixp/pytorch:26.02-b200:
# torch reports as 2.11 dev, but NVIDIA's build does not provide
# torch._opaque_base. Fall back to plain object when the module is absent.
RUN python - <<'PY'
from pathlib import Path

path = Path("vllm/utils/torch_utils.py")
text = path.read_text()
old = '''HAS_OPAQUE_TYPE = is_torch_equal_or_newer("2.11.0.dev")

# Allow toggling LayerName usage via environment variable.
# Defaults to True on torch >= 2.11, False otherwise.
# Set VLLM_USE_LAYERNAME=0 to disable even on torch >= 2.11.
_USE_LAYERNAME = HAS_OPAQUE_TYPE and envs.VLLM_USE_LAYERNAME

if HAS_OPAQUE_TYPE:
    from torch._opaque_base import OpaqueBase
else:
    OpaqueBase = object  # type: ignore[misc, assignment]
'''
new = '''HAS_OPAQUE_TYPE = is_torch_equal_or_newer("2.11.0.dev")

if HAS_OPAQUE_TYPE:
    try:
        from torch._opaque_base import OpaqueBase
    except ModuleNotFoundError:
        HAS_OPAQUE_TYPE = False
        OpaqueBase = object  # type: ignore[misc, assignment]
else:
    OpaqueBase = object  # type: ignore[misc, assignment]

# Allow toggling LayerName usage via environment variable.
# Defaults to True on torch >= 2.11, False otherwise.
# Set VLLM_USE_LAYERNAME=0 to disable even on torch >= 2.11.
_USE_LAYERNAME = HAS_OPAQUE_TYPE and envs.VLLM_USE_LAYERNAME
'''
if old not in text:
    raise SystemExit("expected OpaqueBase block not found")
path.write_text(text.replace(old, new))
PY

RUN python -m pip install --no-cache-dir "setuptools-scm==10.2.0" \
    && python -m pip install --no-cache-dir -e . --no-build-isolation \
    && python -m pip check \
    && python -c "import vllm.version; print(vllm.version.__version__)" \
    && rm -rf /tmp/tmp*.build-temp /tmp/tmp*.build-lib /tmp/pip-* \
        /root/.cache/pip /opt/vllm-venv \
    && (find /tmp -maxdepth 1 -name 'tmpxft_*' -delete 2>/dev/null || true)

# The editable install resolves Python modules from /workspace/vllm, so these
# source overlays apply the local YOCO alignment implementation without
# rebuilding the native extensions pinned above.
COPY vllm/model_executor/models/config.py \
    /workspace/vllm/vllm/model_executor/models/config.py
COPY vllm/model_executor/models/yoco.py \
    /workspace/vllm/vllm/model_executor/models/yoco.py
COPY vllm/model_executor/layers/fused_moe/deep_gemm_utils.py \
    /workspace/vllm/vllm/model_executor/layers/fused_moe/deep_gemm_utils.py
COPY vllm/model_executor/layers/fused_moe/experts/deep_gemm_moe.py \
    /workspace/vllm/vllm/model_executor/layers/fused_moe/experts/deep_gemm_moe.py
COPY vllm/v1/attention/backends/flash_attn.py \
    /workspace/vllm/vllm/v1/attention/backends/flash_attn.py
COPY tools/yoco_alignment/logprob_kl.py \
    /workspace/vllm/tools/yoco_alignment/logprob_kl.py
COPY yoco.md /workspace/vllm/yoco.md

# Builds the validated YOCO runtime on top of the NVIDIA B200 environment.
# Build example:
#   docker build -f docker/Dockerfile.b200 \
#     -t buaahsh/pytorch:26.02-b200-vllm-0725-mixedgraph .

FROM donglixp/pytorch:26.02-b200@sha256:cdbdc71b773142a98a303d488816d2faf6b9d85d179a4639b92263fca6da4769

ENV PIP_NO_CACHE_DIR=1 \
    HF_HOME=/workspace/.cache/huggingface \
    VLLM_TARGET_DEVICE=cuda \
    TORCH_CUDA_ARCH_LIST=10.0 \
    MAX_JOBS=16 \
    NVCC_THREADS=1

WORKDIR /workspace

RUN git init /workspace/vllm \
    && cd /workspace/vllm \
    && git remote add origin https://github.com/buaahsh/vllm.git \
    && git fetch --depth 1 origin f4964c907db7ce2d77c2b0ea39e263375b7eba4f \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "f4964c907db7ce2d77c2b0ea39e263375b7eba4f"

WORKDIR /workspace/vllm

# Match the FlashAttention 4 and CuTeDSL versions already installed in the
# NVIDIA 26.02 image before building vLLM's vendored FA4 package.
COPY cmake/external_projects/vllm_flash_attn.cmake \
    /workspace/vllm/cmake/external_projects/vllm_flash_attn.cmake
COPY requirements/cuda.txt /workspace/vllm/requirements/cuda.txt

# Strip torch/torchvision/torchaudio requirements so the NVIDIA image torch is
# preserved. This is the required first step before pip install.
RUN python use_existing_torch.py

RUN python -m pip install --no-cache-dir "setuptools-scm==10.2.0" \
    && python -m pip install --no-cache-dir -e . --no-build-isolation \
    && python -m pip check \
    && python -c "import vllm.version; print(vllm.version.__version__)" \
    && rm -rf /tmp/tmp*.build-temp /tmp/tmp*.build-lib /tmp/pip-* \
        /root/.cache/pip /opt/vllm-venv \
    && (find /tmp -maxdepth 1 -name 'tmpxft_*' -delete 2>/dev/null || true)

# PT 26.02 already contains FlashAttention 4.0.0b13. The beta13 repository is
# Python/CuTeDSL-only, so keep the CMake-backed FA2/FA3 source above and overlay
# the validated FA4 package into vLLM's namespace after the native build.
RUN python - <<'PY'
from pathlib import Path
import importlib.metadata
import shutil

import flash_attn

expected = {
    "flash-attn-4": "4.0.0b13",
    "nvidia-cutlass-dsl": "4.5.1",
    "quack-kernels": "0.4.1",
}
for package, version in expected.items():
    actual = importlib.metadata.version(package)
    if actual != version:
        raise SystemExit(f"{package}={actual}, expected {version}")

source = Path(flash_attn.__file__).resolve().parent / "cute"
target = Path("/workspace/vllm/vllm/vllm_flash_attn/cute")
shutil.rmtree(target, ignore_errors=True)
shutil.copytree(source, target)
for path in target.rglob("*.py"):
    text = path.read_text()
    path.write_text(text.replace("flash_attn.cute", "vllm.vllm_flash_attn.cute"))
PY

# The editable install resolves Python modules from /workspace/vllm, so these
# source overlays apply the local YOCO alignment implementation without
# rebuilding the native extensions pinned above.
COPY vllm/model_executor/models/config.py \
    /workspace/vllm/vllm/model_executor/models/config.py
COPY vllm/model_executor/models/deepseek_v2.py \
    /workspace/vllm/vllm/model_executor/models/deepseek_v2.py
COPY vllm/model_executor/models/deepseek_v2_utils.py \
    /workspace/vllm/vllm/model_executor/models/deepseek_v2_utils.py
COPY vllm/model_executor/models/yoco.py \
    /workspace/vllm/vllm/model_executor/models/yoco.py
COPY vllm/model_executor/layers/fused_moe/deep_gemm_utils.py \
    /workspace/vllm/vllm/model_executor/layers/fused_moe/deep_gemm_utils.py
COPY vllm/model_executor/layers/fused_moe/experts/deep_gemm_moe.py \
    /workspace/vllm/vllm/model_executor/layers/fused_moe/experts/deep_gemm_moe.py
COPY vllm/v1/attention/backends/flash_attn.py \
    /workspace/vllm/vllm/v1/attention/backends/flash_attn.py
COPY vllm/entrypoints/openai/chat_completion/protocol.py \
    /workspace/vllm/vllm/entrypoints/openai/chat_completion/protocol.py
COPY vllm/entrypoints/openai/chat_completion/batch_serving.py \
    /workspace/vllm/vllm/entrypoints/openai/chat_completion/batch_serving.py
COPY vllm/entrypoints/openai/chat_completion/serving.py \
    /workspace/vllm/vllm/entrypoints/openai/chat_completion/serving.py
COPY vllm/entrypoints/openai/responses/streaming_events.py \
    /workspace/vllm/vllm/entrypoints/openai/responses/streaming_events.py
COPY vllm/parser/__init__.py \
    /workspace/vllm/vllm/parser/__init__.py
COPY vllm/parser/agens_parser.py \
    /workspace/vllm/vllm/parser/agens_parser.py
COPY vllm/reasoning/__init__.py \
    /workspace/vllm/vllm/reasoning/__init__.py
COPY vllm/reasoning/agens_reasoning_parser.py \
    /workspace/vllm/vllm/reasoning/agens_reasoning_parser.py
COPY vllm/tool_parsers/__init__.py \
    /workspace/vllm/vllm/tool_parsers/__init__.py
COPY vllm/tool_parsers/agens_tool_parser.py \
    /workspace/vllm/vllm/tool_parsers/agens_tool_parser.py
COPY tools/yoco_alignment/logprob_kl.py \
    /workspace/vllm/tools/yoco_alignment/logprob_kl.py
COPY tools/yoco_alignment/rl_rollout.py \
    /workspace/vllm/tools/yoco_alignment/rl_rollout.py
COPY yoco.md /workspace/vllm/yoco.md

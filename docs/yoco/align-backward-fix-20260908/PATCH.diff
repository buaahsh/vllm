@@ -22,8 +22,12 @@ def _count_routes(
     ids, counts, ROUTES: tl.constexpr, EXPERTS: tl.constexpr, BLOCK: tl.constexpr
 ):
     offsets = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)

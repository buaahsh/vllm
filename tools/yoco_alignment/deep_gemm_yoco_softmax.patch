+
+// The warp's first eight lanes hold the selected BF16-rounded logits in rank order.
+template <uint32_t kNumTopk>
+CUTLASS_DEVICE void store_yoco_softmax_topk_token(const RoutingArgs& args,
+                                                 const uint32_t global_token_idx,
+                                                 const uint32_t lane_idx,
+                                                 const int selected_expert_idx,
+                                                 const float selected_logit) {
+    DG_STATIC_ASSERT(kNumTopk == 8, "YOCO selects eight experts");
+    const auto value = lane_idx < kNumTopk ? selected_logit : -cute::numeric_limits<float>::infinity();
+    const auto selected_max = ptx::reduce_max_sync(value);
+    const auto numerator = lane_idx < kNumTopk ? expf(value - selected_max) : 0.0f;
+    const auto denominator = math::warp_reduce_sum<8>(numerator);
+    if (lane_idx < kNumTopk) {
+        const auto output_idx = static_cast<uint64_t>(global_token_idx) * kNumTopk + lane_idx;
+        args.yoco_topk_idx[output_idx] = selected_expert_idx;
+        args.topk_weights[output_idx] = numerator / denominator;
+    }
 }
 
